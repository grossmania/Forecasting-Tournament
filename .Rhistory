site_prosocial.SWIS+
site_metacog.SWIS+            # group-means
(1|vignette)+(1|site/id), # Random Intercepts for people within cultures
data = d.all,
family = binomial,
#nAGQ=0, #the latter argument speeds up the process with complex models in glmer
control=glmerControl(optimizer="bobyqa"#,
#optCtrl=list(maxfun=2e5)
)
)
###add individual differences on top of it
use_glmer_INDINTERD_group_ind <-
lme4::glmer(
use.external ~
site_indep+
site_interdep+
site_NFC+
site_outsider.SWIS+
site_prosocial.SWIS+
site_metacog.SWIS+
site_c_indep+
site_c_interdep+
site_c_NFC+
site_c_outsider.SWIS+
site_c_prosocial.SWIS+
site_c_metacog.SWIS+
(1|vignette)+(1|site/id),      # Random Intercepts for people within cultures
data = d.all,
family = binomial, nAGQ=0, #the latter argument speeds up the process with complex models in glmer
control=glmerControl(optimizer="bobyqa"#,
#optCtrl=list(maxfun=2e5)
)
)
summarize_values<-d.all %>%
dplyr::group_by(site) %>%
dplyr::summarize(site_independence_values = mean(indep, na.rm=TRUE),
site_interdependence_values = mean(interdep, na.rm=TRUE)) %>%   ungroup()
# Custom mapping of site names to unique 3-character codes mostly using ISO codes
site_mapping <- c(
"Canada" = "CAN",            # ISO code for Canada
"China" = "CHN",             # ISO code for China
"Ecuador (Spanish)" = "ECU", # ISO code for Ecuador
"Germany" = "GER",           # ISO code for Germany
"India (Hindi)" = "IN-H",    # "IN" for India, "H" for Hindi
"India (Tamil / Meitei)" = "IN-TM", # "IN" for India, "TM" for Tamil/Meitei
"Japan" = "JPN",             # ISO code for Japan
"Morocco" = "MAR",           # ISO code for Morocco
"Peru (Spanish)" = "PER",    # ISO code for Peru
"SAfrica (English)" = "ZA-E", # "ZA" for South Africa, "E" for English
"SAfrica (Zulu)" = "ZA-Z",   # "ZA" for South Africa, "Z" for Zulu
"SKorea" = "KOR",            # ISO code for South Korea
"Shipibo, Peru" = "SHIP",    # Clear and intuitive abbreviation
"Shiwiar, Ecuador" = "SHIW", # Clear and intuitive abbreviation
"Slovakia" = "SVK",          # ISO code for Slovakia
"USA" = "USA"                # ISO code for USA
)
# Apply the final mapping to your data
summarize_values$short_site <- site_mapping[summarize_values$site]
# Compute the effects for the specific site_interdep and site_indep values
eff_ind <- effects::effect("site_indep",
mod = use_glmer_INDINTERD_group_ind,
xlevels = list(
site_indep = summarize_values$site_independence_values
),se=TRUE)
indep_plot<-data.frame(eff_ind)
eff_interdep <- effects::effect("site_interdep",
mod = use_glmer_INDINTERD_group_ind,
xlevels = list(
site_interdep = summarize_values$site_interdependence_values
),se=TRUE)
interdep_plot<-data.frame(eff_interdep)
summarize_values_ind<-bind_cols(summarize_values,indep_plot)
summarize_values_interdep<-bind_cols(summarize_values,interdep_plot)
# Create the plot with final site labels at a 90-degree angle
plot_independence <- ggplot(summarize_values_ind, aes(x = site_indep, y = fit)) +
geom_line(color = "#9671b2") +  # Line for predicted probabilities
labs(x = "Site Independence", y = "Probability of Choosing Advice & 95% CI") +
theme_minimal() +
geom_linerange(aes(ymin = lower, ymax = upper), alpha=.3) +  # Add confidence intervals as lineranges
geom_point() +  # Scatter plot of points
geom_hline(yintercept = 0.50, linetype = "dashed", color = "black") +  # Add a dashed line at y = 0.50
ylim(0, .55) + #xlim(2.8,4.4)+ # Set  limits
geom_text_repel(aes(label = short_site),  # Use the final site labels
max.overlaps = 10)  # Repel overlapping text, allow some overlap
# Plotting the results
plot_interdependence <- ggplot(summarize_values_interdep, aes(x = site_interdep, y = fit)) +
geom_line(color = "#9671b2") +  # Line for predicted probabilities
labs(x = "Site Interdependence", y=NULL) +  # No y-axis label as per original code
theme_minimal() +
geom_linerange(aes(ymin = lower, ymax = upper), alpha=.3) +  # Add confidence intervals as lineranges
geom_point() +  # Scatter plot of points
geom_hline(yintercept = 0.50, linetype = "dashed", color = "black") +  # Add a dashed line at y = 0.50
ylim(0, .55) + #xlim(2.8,4.4)+ # Set  limits
geom_text_repel(aes(label = short_site),  # Use the final site labels
max.overlaps = 10)  # Repel overlapping text, allow some overlap
#combine panels
