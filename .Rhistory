#ADD INDIV DIFFERENCE SCORES
d.all = d.all %>%
dplyr::group_by(site)%>%
dplyr::mutate(site_outsider.SWIS = mean(outsider.SWIS, na.rm = TRUE),
site_prosocial.SWIS = mean(prosocial.SWIS, na.rm = TRUE),
site_metacog.SWIS = mean(metacog.SWIS, na.rm = TRUE),
site_indep = mean(indep, na.rm=TRUE),
site_indep.no10 = mean(indep.no10, na.rm=TRUE),
site_indep.i10= mean(oys_10, na.rm=TRUE),
site_interdep = mean(interdep, na.rm=TRUE),
site_soc_orient = mean(soc_orient, na.rm=TRUE),
site_NFC = mean(NFC, na.rm=T),
site_c_outsider.SWIS = outsider.SWIS - mean(outsider.SWIS, na.rm = TRUE),
site_c_prosocial.SWIS = prosocial.SWIS - mean(prosocial.SWIS, na.rm = TRUE),
site_c_metacog.SWIS = metacog.SWIS - mean(metacog.SWIS, na.rm = TRUE),
site_c_indep = indep - mean(indep, na.rm=TRUE),
site_c_indep.no10 = indep.no10 - mean(indep.no10, na.rm=TRUE),
site_c_indep.i10 = oys_10 - mean(oys_10, na.rm=TRUE),
site_c_interdep = interdep - mean(interdep, na.rm=TRUE),
site_c_soc_orient = soc_orient - mean(soc_orient, na.rm=TRUE),
site_c_NFC = NFC - mean(NFC, na.rm=T))
###examine cultural differences due to site differences in IND and COL, NFC, and Meta-Cognition, Prosociality endorsements
use_glmer_INDINTERD_group <-
lme4::glmer(
use.external ~
site_indep+
site_interdep+
site_NFC+
site_outsider.SWIS+
site_prosocial.SWIS+
site_metacog.SWIS+            # group-means
(1|vignette)+(1|site/id), # Random Intercepts for people within cultures
data = d.all,
family = binomial,
#nAGQ=0, #the latter argument speeds up the process with complex models in glmer
control=glmerControl(optimizer="bobyqa"#,
#optCtrl=list(maxfun=2e5)
)
)
###examine cultural differences due to site differences in IND and COL, NFC, and Meta-Cognition, Prosociality endorsements
use_glmer_INDINTERD_group <-
lme4::glmer(
use.external ~
